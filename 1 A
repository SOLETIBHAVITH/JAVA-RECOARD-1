class Student {
    String name;
    int age;

    void display() {
        System.out.println("Student Name: " + name);
        System.out.println("Student Age: " + age);
    }
}

public class Main {
    public static void main(String[] args) {
        Student student = new Student();
        student.name = "Ravi";
        student.age = 19;
        Student reference = student;
        student.display();
        reference.display();
        System.out.println("Same object: " + (student == reference));
    }
}

/*
Output:
Student Name: Ravi
Student Age: 19
Student Name: Ravi
Student Age: 19
Same object: true
*/
